#!/usr/bin/env python3
"""alfred-ops: the only command Alfred's ops key may run on a homelab host.

Installed as ~/bin/alfred-ops and pinned in ~/.ssh/authorized_keys:
    command="/home/user/bin/alfred-ops",restrict ssh-ed25519 AAAA... alfred-ops@alfred-server
The requested operation arrives in SSH_ORIGINAL_COMMAND and is validated here; nothing is passed
to a shell.

    status                     host vitals + containers (JSON)
    logs <container> [lines]   last log lines of an allowlisted container (max 200)
    restart <container>        restart an allowlisted container
    mc                         Minecraft: version, players online (server list ping; RCON not needed)
    updates                    report only: pending OS packages (from apt's existing lists), reboot
                               needed, and containers whose image tag has a newer build upstream
                               (registry HEAD requests; nothing is pulled or installed)

Allowlist: ~/.config/alfred-ops/allow, one container name per line. Restarts and logs are refused
for anything not listed there.
"""
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor

ALLOW_FILE = os.path.expanduser("~/.config/alfred-ops/allow")
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$")
MC_IMAGES = ("itzg/minecraft-server",)


def out(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def allowlist():
    try:
        with open(ALLOW_FILE) as f:
            return {ln.strip() for ln in f if ln.strip() and not ln.startswith("#")}
    except FileNotFoundError:
        return set()


def run(args, timeout=20):
    p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    return p.returncode, p.stdout, p.stderr


def disk(path):
    if not os.path.isdir(path):
        return None
    u = shutil.disk_usage(path)
    return {"path": path, "used_pct": round(u.used / u.total * 100, 1), "free_gb": round(u.free / 1e9, 1)}


def temperature():
    temps = []
    for zone in sorted(os.listdir("/sys/class/thermal")) if os.path.isdir("/sys/class/thermal") else []:
        try:
            with open(f"/sys/class/thermal/{zone}/temp") as f:
                temps.append(int(f.read().strip()) / 1000)
        except Exception:  # some sensors (e.g. on the Jetson) error when read; skip them
            pass
    temps = [t for t in temps if -20 < t < 150]
    return round(max(temps), 1) if temps else None


def throttled():
    if not shutil.which("vcgencmd"):
        return None
    code, so, _ = run(["vcgencmd", "get_throttled"], 5)
    m = re.search(r"0x([0-9a-fA-F]+)", so) if code == 0 else None
    if not m:
        return None
    v = int(m.group(1), 16)
    return {"under_voltage_now": bool(v & 0x1), "throttled_now": bool(v & 0x4),
            "under_voltage_since_boot": bool(v & 0x10000), "throttled_since_boot": bool(v & 0x40000)}


def containers():
    if not shutil.which("docker"):
        return None
    code, so, se = run(["docker", "ps", "-a", "--format", "{{json .}}"])
    if code:
        return {"error": se.strip()[:200]}
    items = []
    for line in so.splitlines():
        c = json.loads(line)
        status = c.get("Status", "")
        items.append({"name": c.get("Names"), "image": c.get("Image"), "state": c.get("State"),
                      "status": status, "health": "unhealthy" if "unhealthy" in status else
                      "healthy" if "(healthy)" in status else None})
    return items


def status():
    with open("/proc/loadavg") as f:
        load = [float(x) for x in f.read().split()[:3]]
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])
    mem = {}
    with open("/proc/meminfo") as f:
        for ln in f:
            k, v = ln.split(":", 1)
            mem[k] = int(v.split()[0]) * 1024
    allowed = allowlist()
    out({"host": socket.gethostname(), "time": int(time.time()), "uptime_h": round(uptime / 3600, 1),
         "cpus": os.cpu_count(), "load": load,
         "mem_used_pct": round((1 - mem.get("MemAvailable", 0) / mem["MemTotal"]) * 100, 1),
         "mem_total_gb": round(mem["MemTotal"] / 1e9, 1),
         "disks": [d for d in (disk("/"), disk("/ssd"), disk("/mnt/nas")) if d],
         "temp_c": temperature(), "power": throttled(), "containers": containers(),
         "manageable": sorted(allowed)})


def apt_updates():
    if not shutil.which("apt"):
        return None
    code, so, _ = run(["apt", "list", "--upgradable"], 60)       # reads the cached lists; no root needed
    pkgs = [ln.split("/", 1)[0] for ln in so.splitlines() if "/" in ln and "[upgradable" in ln]
    security = [ln.split("/", 1)[0] for ln in so.splitlines() if "[upgradable" in ln and "-security" in ln]
    try:
        lists_age_d = round((time.time() - os.path.getmtime("/var/lib/apt/lists")) / 86400, 1)
    except OSError:
        lists_age_d = None
    return {"count": len(pkgs), "security": len(security), "names": pkgs[:40], "lists_age_d": lists_age_d}


_ACCEPT = ", ".join(["application/vnd.oci.image.index.v1+json", "application/vnd.docker.distribution.manifest.list.v2+json",
                     "application/vnd.oci.image.manifest.v1+json", "application/vnd.docker.distribution.manifest.v2+json"])


def _split_ref(ref):
    name, tag = ref, "latest"
    if "@" in name:
        return None
    if ":" in name.rsplit("/", 1)[-1]:
        name, tag = name.rsplit(":", 1)
    first = name.split("/", 1)[0]
    if "/" in name and ("." in first or ":" in first or first == "localhost"):
        registry, repo = first, name.split("/", 1)[1]
    else:
        registry, repo = "registry-1.docker.io", name if "/" in name else f"library/{name}"
    return registry, repo, tag


def _head(url, token=None):
    req = urllib.request.Request(url, method="HEAD", headers={"Accept": _ACCEPT, "User-Agent": "alfred-ops"})
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    return urllib.request.urlopen(req, timeout=10)


def remote_digest(ref):
    """Digest of the tag upstream (anonymous; HEAD requests don't count against Docker Hub's pull limit)."""
    parts = _split_ref(ref)
    if not parts:
        return None
    registry, repo, tag = parts
    url = f"https://{registry}/v2/{repo}/manifests/{tag}"
    try:
        return _head(url).headers.get("Docker-Content-Digest")
    except urllib.error.HTTPError as e:
        if e.code != 401:
            return None
        chal = e.headers.get("WWW-Authenticate", "")
        fields = dict(re.findall(r'(\w+)="([^"]*)"', chal))
        if not chal.lower().startswith("bearer") or "realm" not in fields:
            return None
        q = "&".join(f"{k}={urllib.request.quote(fields[k], safe=':/')}" for k in ("service", "scope") if k in fields)
        if "scope" not in fields:
            q += ("&" if q else "") + f"scope=repository:{repo}:pull"
        try:
            with urllib.request.urlopen(f"{fields['realm']}?{q}", timeout=10) as r:
                tok = json.loads(r.read()).get("token") or ""
            return _head(url, tok).headers.get("Docker-Content-Digest")
        except Exception:  # noqa: BLE001 — unknown registry quirks: just "can't tell"
            return None
    except Exception:  # noqa: BLE001
        return None


def image_updates():
    if not shutil.which("docker"):
        return None
    code, so, _ = run(["docker", "ps", "-a", "--format", "{{.Names}}\t{{.Image}}"])
    if code:
        return None
    pairs = [ln.split("\t", 1) for ln in so.splitlines() if "\t" in ln]
    refs = sorted({img for _, img in pairs})
    local = {}
    for ref in refs:
        code, so, _ = run(["docker", "image", "inspect", "--format", "{{json .RepoDigests}}", ref])
        local[ref] = [d.split("@", 1)[1] for d in (json.loads(so) if code == 0 and so.strip() else []) or []]
    checkable = [r for r in refs if local[r]]
    with ThreadPoolExecutor(max_workers=4) as pool:
        remote = dict(zip(checkable, pool.map(remote_digest, checkable)))
    items = []
    for name, ref in pairs:
        if not local[ref]:
            state = "built here"
        elif remote.get(ref) is None:
            state = "cannot check"        # built here, private, or the registry did not answer
        else:
            state = "current" if remote[ref] in local[ref] else "newer upstream"
        items.append({"container": name, "image": ref, "state": state})
    return items


def updates():
    osr = {}
    try:
        with open("/etc/os-release") as f:
            osr = dict(ln.rstrip().split("=", 1) for ln in f if "=" in ln)
    except OSError:
        pass
    code, so, _ = run(["docker", "version", "--format", "{{.Server.Version}}"], 10) if shutil.which("docker") else (1, "", "")
    out({"host": socket.gethostname(), "os": osr.get("PRETTY_NAME", "").strip('"'), "kernel": os.uname().release,
         "docker": so.strip() if code == 0 else None, "reboot_required": os.path.exists("/var/run/reboot-required"),
         "packages": apt_updates(), "images": image_updates()})


def need_allowed(name):
    if not NAME.match(name or ""):
        out({"error": "bad container name"}, 2)
    if name not in allowlist():
        out({"error": f"'{name}' is not on this host's allowlist"}, 3)


def main():
    argv = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", "") or " ".join(sys.argv[1:]))
    if not argv:
        out({"error": "no operation"}, 2)
    op, args = argv[0], argv[1:]
    if op == "status" and not args:
        status()
    if op == "logs" and 1 <= len(args) <= 2:
        need_allowed(args[0])
        lines = min(int(args[1]), 200) if len(args) == 2 and args[1].isdigit() else 50
        code, so, se = run(["docker", "logs", "--tail", str(lines), args[0]])
        out({"container": args[0], "ok": code == 0, "logs": (so + se)[-12000:]})
    if op == "restart" and len(args) == 1:
        need_allowed(args[0])
        code, so, se = run(["docker", "restart", args[0]], 120)
        out({"container": args[0], "ok": code == 0, "detail": (se or so).strip()[:300]}, 0 if code == 0 else 1)
    if op == "mc" and not args:
        for c in containers() or []:
            if any(c["image"].startswith(i) for i in MC_IMAGES) and c["name"] in allowlist():
                # Server list ping (what any client sees); works without RCON, which stays off.
                code, so, se = run(["docker", "exec", c["name"], "mc-monitor", "status", "-json"], 15)
                if code:
                    out({"container": c["name"], "ok": False, "error": (se or so).strip()[:300]})
                info = json.loads(so).get("server_info", {})
                players = info.get("players") or {}
                out({"container": c["name"], "ok": True, "state": c["state"], "health": c["health"],
                     "version": (info.get("version") or {}).get("name"),
                     "online": players.get("online"), "max": players.get("max"),
                     "players": [p.get("name") for p in (players.get("sample") or players.get("Sample") or [])]})
        out({"error": "no allowlisted Minecraft container on this host"}, 3)
    if op == "updates" and not args:
        updates()
    out({"error": f"operation not allowed: {op}"}, 2)


if __name__ == "__main__":
    main()
