# Alfred configuration — copy to .env and fill in. Never commit .env.
# Every channel switches itself on only when its keys are present, so you can
# add keys one at a time (Claude + Telegram first, then n8n, then Twilio/ElevenLabs).
# Values containing '$' (e.g. Argon2 hashes) MUST be wrapped in single quotes.

# ---------------------------------------------------------------- Claude (Agent Core)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=2048
# How many past user/assistant turns (per channel, per person) are sent as context
AGENT_HISTORY_TURNS=40
ASSISTANT_NAME=Alfred
TZ=Europe/Zurich

# ---------------------------------------------------------------- Admin (seeded ONCE, on first start only)
# After that, manage people on the dashboard (Personnel / Profile); these values are no longer re-applied.
ADMIN_DISPLAY_NAME=Erika
# Your numeric Telegram user ID (ask @userinfobot), NOT your @username
ADMIN_TELEGRAM_ID=
# E.164, matched against caller ID, e.g. +41790000100
ADMIN_PHONE=
ADMIN_EMAIL=
DASHBOARD_ADMIN_USERNAME=admin
# Generate: docker compose run --rm alfred python -m orchestrator.identity.admin_cli hash-password
# (or skip this and use `admin_cli set-password 1 admin` after first start)
DASHBOARD_ADMIN_PASSWORD_HASH=''

# ---------------------------------------------------------------- Telegram
# From @BotFather. Long polling is used, so no public URL is needed for Telegram.
TELEGRAM_BOT_TOKEN=
# A Telegram "session" closes after this many idle minutes (context still carries over)
TELEGRAM_SESSION_IDLE_MINUTES=30

# ---------------------------------------------------------------- n8n
# n8n on the proxy host is bound to 127.0.0.1, so use its public hostname (or a tailnet URL)
N8N_BASE_URL=https://n8n.example.com
# n8n → Settings → n8n API → Create API key (full scope)
N8N_API_KEY=
# Shared secret n8n sends as X-Alfred-Secret when POSTing to /n8n/callback
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_CALLBACK_SECRET=

# ---------------------------------------------------------------- Google Calendar (per-user linking)
# Google Cloud Console -> APIs & Services: enable "Google Calendar API", create an OAuth client
# (type "Web application") with redirect URI  {PUBLIC_BASE_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google tokens. Generate once, never change (changing it forces everyone to relink):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Google Search Console ownership proof for https://alfred.example.com (URL-prefix property).
# HTML tag method: paste only the content="..." value. HTML file method: paste the file name.
GOOGLE_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION_FILE=

# ---------------------------------------------------------------- Twilio (phone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Swiss Twilio number, E.164
TWILIO_PHONE_NUMBER=
# Keep true in production; only disable for local testing without a tunnel
TWILIO_VALIDATE_SIGNATURE=true
DEFAULT_COUNTRY_CODE=41

# ---------------------------------------------------------------- ElevenLabs (speech)
ELEVENLABS_API_KEY=
# Voice to speak with (Voice Library → copy voice ID)
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# ISO code to pin recognition (e.g. en, de, fr); empty = auto-detect
STT_LANGUAGE=
# Swap point for later: elevenlabs | local (Jetson Whisper + Piper, Phase 5)
STT_TTS_PROVIDER=elevenlabs

# ---------------------------------------------------------------- Dashboard / networking
# Public HTTPS URL Twilio calls back to (Cloudflare Tunnel → the proxy host Caddy → this Pi), no trailing slash
PUBLIC_BASE_URL=https://alfred.example.com
# Key for hashing dashboard session tokens (min 32 chars).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SESSION_SECRET=
# true when served over HTTPS (normal); false only for plain-http LAN testing
DASHBOARD_COOKIE_SECURE=true
# Logins expire after this much inactivity, and after DASHBOARD_SESSION_MAX_HOURS regardless
DASHBOARD_SESSION_IDLE_MINUTES=60
DASHBOARD_SESSION_MAX_HOURS=12
# Proxies allowed to report the real client IP (CF-Connecting-IP / X-Forwarded-For).
# the reverse proxy reaches this Pi over Tailscale from 100.64.0.2. Comma-separated.
TRUSTED_PROXY_IPS=100.64.0.2
# Host interface/port the container publishes on (use the Pi 5 tailnet IP to restrict)
ALFRED_BIND=0.0.0.0
ALFRED_PORT=8000

# ---------------------------------------------------------------- Usage / cost estimates (USD)
# Claude Haiku 4.5 list prices per million tokens (update if your pricing differs)
PRICE_CLAUDE_INPUT_PER_MTOK=1.00
PRICE_CLAUDE_OUTPUT_PER_MTOK=5.00
PRICE_CLAUDE_CACHE_READ_PER_MTOK=0.10
PRICE_CLAUDE_CACHE_WRITE_PER_MTOK=1.25
# ElevenLabs bills per plan; set your effective rates to see cost estimates (0 = just count usage)
PRICE_ELEVENLABS_TTS_PER_1K_CHARS=0
PRICE_ELEVENLABS_STT_PER_HOUR=0

# ---------------------------------------------------------------- Storage
# Inside the container. Local disk now; point at a NAS mount later (see docker-compose.yml)
STORAGE_ROOT=/data/storage
LOG_LEVEL=INFO
