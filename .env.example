# Alfred configuration — copy to .env and fill in. Never commit .env.
# Every channel switches itself on only when its keys are present, so you can
# add keys one at a time (Claude + Telegram first, then n8n, then Twilio/ElevenLabs).
# Values containing '$' (e.g. Argon2 hashes) MUST be wrapped in single quotes.

# ---------------------------------------------------------------- Claude (Agent Core)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=2048
# How many past user/assistant turns (per channel, per person) are sent as context
AGENT_HISTORY_TURNS=40
ASSISTANT_NAME=Alfred
TZ=Europe/Zurich

# ---------------------------------------------------------------- Admin (seeded into the registry on startup)
ADMIN_DISPLAY_NAME=Erika
# Your numeric Telegram user ID (ask @userinfobot), NOT your @username
ADMIN_TELEGRAM_ID=
# E.164, matched against caller ID, e.g. +41790000100
ADMIN_PHONE=
ADMIN_EMAIL=
DASHBOARD_ADMIN_USERNAME=admin
# Generate: docker compose run --rm alfred python -m orchestrator.identity.admin_cli hash-password
# (or skip this and use `admin_cli set-password 1 admin` after first start)
DASHBOARD_ADMIN_PASSWORD_HASH=''

# ---------------------------------------------------------------- Telegram
# From @BotFather. Long polling is used, so no public URL is needed for Telegram.
TELEGRAM_BOT_TOKEN=
# A Telegram "session" closes after this many idle minutes (context still carries over)
TELEGRAM_SESSION_IDLE_MINUTES=30

# ---------------------------------------------------------------- n8n
# n8n on the proxy host is bound to 127.0.0.1, so use its public hostname (or a tailnet URL)
N8N_BASE_URL=https://n8n.example.com
# n8n → Settings → n8n API → Create API key (full scope)
N8N_API_KEY=
# Shared secret n8n sends as X-Alfred-Secret when POSTing to /n8n/callback
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_CALLBACK_SECRET=

# ---------------------------------------------------------------- Twilio (phone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Swiss Twilio number, E.164
TWILIO_PHONE_NUMBER=
# Keep true in production; only disable for local testing without a tunnel
TWILIO_VALIDATE_SIGNATURE=true
DEFAULT_COUNTRY_CODE=41

# ---------------------------------------------------------------- ElevenLabs (speech)
ELEVENLABS_API_KEY=
# Voice to speak with (Voice Library → copy voice ID)
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# ISO code to pin recognition (e.g. en, de, fr); empty = auto-detect
STT_LANGUAGE=
# Swap point for later: elevenlabs | local (Jetson Whisper + Piper, Phase 5)
STT_TTS_PROVIDER=elevenlabs

# ---------------------------------------------------------------- Dashboard / networking
# Public HTTPS URL Twilio calls back to (Cloudflare Tunnel → the proxy host Caddy → this Pi), no trailing slash
PUBLIC_BASE_URL=https://alfred.example.com
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SESSION_SECRET=
# true when served over HTTPS (normal); false only for plain-http LAN testing
DASHBOARD_COOKIE_SECURE=true
# Host interface/port the container publishes on (use the Pi 5 tailnet IP to restrict)
ALFRED_BIND=0.0.0.0
ALFRED_PORT=8000

# ---------------------------------------------------------------- Storage
# Inside the container. Local disk now; point at a NAS mount later (see docker-compose.yml)
STORAGE_ROOT=/data/storage
LOG_LEVEL=INFO
